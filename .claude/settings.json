{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/cerebro/cerebro.py\" hook 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Cerebro: revisando lo que se tocó"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/cerebro/cerebro.py\" inicio 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
