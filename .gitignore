# DATOS DEL USUARIO — nunca versionar ni revertir (regla dura [[no-revertir-datos-usuario]])
datos/
entrada/
trabajos/
.preview_sandbox/

# Python
__pycache__/
*.pyc

# Frontend: dependencias y build (se regeneran con npm install / npm run build)
frontend/node_modules/
frontend/dist/

# Fuentes subidas en runtime
catalogo_fuentes/subida_*

# Respaldos pesados y logs
respaldo*.rar
*.log
nul

# Sistema
Thumbs.db
.DS_Store

# base de datos local (no se versiona)
*.mdf
*.ldf

# respaldos de moldes viejos (no versionar)
respaldo_moldes_*/

# Banco de pruebas y paquetes generados (se rearman con empaquetar.py)
scratchpad/
dist/

# Generado en el SERVIDOR por el instalador (cada máquina tiene lo suyo, y config_publicado.bat
# lleva la CLAVE de sesión: nunca va al repositorio)
config_publicado.bat
arrancar.bat
instalacion_log.txt
servidor_log.txt
DIAGNOSTICO.txt
perfiles_icc/
_actualizacion/
_tarea.xml

# Secretos de APIs externas (api-key de telas del WMS) — NUNCA versionar
config_externo.json

# clave de sesion del servidor publicado (se genera sola, NO se versiona)
secret.txt
