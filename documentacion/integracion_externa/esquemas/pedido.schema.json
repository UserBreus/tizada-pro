{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tizadapro/esquemas/pedido.schema.json",
  "title": "TIZADA PRO — pedido.json (tizadapro.pedido/1)",
  "description": "El archivo pedido.json que va en la raíz del paquete .zip. Este esquema revisa la FORMA; que los valores existan (variables, telas, talles, opciones) lo revisa TIZADA con POST /pedidos/validar.",
  "type": "object",
  "required": [
    "formato",
    "referencia",
    "disenos",
    "planilla"
  ],
  "additionalProperties": false,
  "properties": {
    "formato": {
      "const": "tizadapro.pedido/1"
    },
    "referencia": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "El número del pedido en el otro sistema. Único. Carpeta en Drive y prefijo de cada archivo."
    },
    "pedido_externo": {
      "type": "object",
      "description": "Libre. Vuelve TAL CUAL en el resultado."
    },
    "cliente": {
      "type": "string"
    },
    "aviso_url": {
      "type": "string",
      "format": "uri",
      "description": "Sólo vale si es del mismo sitio que la configurada en Integraciones."
    },
    "reemplazar": {
      "type": "boolean",
      "description": "true para rehacer un pedido ya listo con la misma referencia."
    },
    "opciones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "si_falta_tipografia": {
          "enum": [
            "rechazar",
            "predeterminada"
          ]
        },
        "si_texto_no_entra": {
          "enum": [
            "achicar",
            "rechazar"
          ]
        },
        "si_piezas_en_blanco": {
          "enum": [
            "rechazar",
            "seguir"
          ]
        },
        "perfil_color": {
          "type": "string",
          "description": "El perfil de color a forzar: el archivo o el nombre de uno de GET /perfiles (MAPA 712: se valida, alarma perfil-desconocido)."
        },
        "carpeta": {
          "type": "string",
          "description": "Subcarpeta de Drive (puede tener niveles: 2026-10/OV-123)."
        }
      }
    },
    "mesas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modo": {
          "enum": [
            "normal",
            "una_por_fila",
            "por_talles",
            "talles_separados"
          ]
        },
        "grupos": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "description": "Sólo con modo por_talles: los talles de cada grupo comparten mesa."
        },
        "largo_max_m": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 50,
          "description": "Opcional: el largo máximo de cada mesa del pedido, en metros. Sin él rige el del nesting del molde (MAPA 716)."
        },
        "separar_disenos": {
          "type": "boolean",
          "default": false,
          "description": "true: cada diseño en sus propias mesas. Sin él, el mismo molde se mezcla aunque cambie el diseño (MAPA 717)."
        }
      }
    },
    "disenos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "nombre",
          "moldes"
        ],
        "additionalProperties": false,
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "description": "JUGADOR, GOLERO… Único. Es el valor de la columna diseno de la planilla."
          },
          "arte": {
            "$ref": "#/$defs/rutaArte",
            "description": "Arte para todas las variables de este diseño que no traigan el suyo."
          },
          "tipografias": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rutaFuente"
            }
          },
          "tipografia_por_campo": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "{\"numero\": \"Anton Regular\"}: forzar una tipografía del catálogo para un campo."
          },
          "moldes": {
            "type": "array",
            "minItems": 1,
            "description": "Las VARIABLES elegidas para el diseño (una por prenda).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tela"
              ],
              "anyOf": [
                {
                  "required": [
                    "variable"
                  ]
                },
                {
                  "required": [
                    "molde"
                  ]
                }
              ],
              "properties": {
                "variable": {
                  "type": "string",
                  "description": "Clave v_… (de GET /variables) o el nombre de la variable."
                },
                "molde": {
                  "type": "string",
                  "description": "Opcional: código prod_… (sólo si la variable va por un nombre que está en varias prendas)."
                },
                "arte": {
                  "$ref": "#/$defs/rutaArte"
                },
                "tela": {
                  "type": "string",
                  "description": "id de la tela principal (GET /telas)."
                },
                "telas_por_pieza": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "{\"Cuello\": \"486\"}: pieza (nombre genérico) → id de tela."
                },
                "piezas_apagadas": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "forma": {
                  "type": "string",
                  "enum": [
                    "rectangulo",
                    "circulo",
                    "triangulo",
                    "rectángulo",
                    "círculo",
                    "triángulo"
                  ],
                  "description": "Sólo A MEDIDA: la forma de la pieza (sin esto, rectángulo). Círculo: la medida es el diámetro. Triángulo: isósceles, con `orientacion`."
                },
                "orientacion": {
                  "type": "string",
                  "enum": [
                    "abajo",
                    "arriba",
                    "izq",
                    "der",
                    "izquierda",
                    "derecha"
                  ],
                  "description": "Sólo TRIÁNGULO: hacia dónde va la punta (sin esto, abajo = banderín)."
                },
                "terminacion": {
                  "type": "string",
                  "enum": [
                    "dobladillo",
                    "overlock",
                    "sin",
                    "sin margen"
                  ],
                  "description": "Sólo A MEDIDA: cómo se termina el borde (sin esto, la del molde). dobladillo = el margen del molde, doblado; overlock = la forma tal cual con overlock_cm; sin = sin margen (las tiras van sólo en la ficha)."
                },
                "medida": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Sólo prendas A MEDIDA (`a_medida` en GET /variables): la medida del DISEÑO, en metros (TIZADA le suma el margen). Rectángulo y triángulo: ancho_m y alto_m (en el triángulo, su caja). Círculo: diametro_m (o ancho_m).",
                  "properties": {
                    "ancho_m": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 50
                    },
                    "alto_m": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 50
                    },
                    "diametro_m": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 50
                    },
                    "forma": {
                      "type": "string",
                      "enum": [
                        "rectangulo",
                        "circulo",
                        "triangulo",
                        "rectángulo",
                        "círculo",
                        "triángulo"
                      ]
                    },
                    "orientacion": {
                      "type": "string",
                      "enum": [
                        "abajo",
                        "arriba",
                        "izq",
                        "der",
                        "izquierda",
                        "derecha"
                      ]
                    }
                  }
                },
                "tiras": {
                  "description": "Sólo prendas A MEDIDA: las marcas para coser las tiras. Cada lado CUENTA LAS 2 PUNTAS (0 = sin tiras, 1 = una en el medio). Rectángulo: arriba/abajo/izq/der · triángulo: base/laterales · círculo: alrededor (parejas, hasta 200). Sin esto: las del molde.",
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "lleva": {
                          "type": "boolean"
                        },
                        "marcar": {
                          "type": "boolean",
                          "description": "false = no se imprimen en la tizada; salen en la ficha técnica."
                        },
                        "lados": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "arriba": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "abajo": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "izq": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "der": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "izquierda": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "derecha": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "base": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "laterales": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "alrededor": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 200
                            }
                          }
                        },
                        "arriba": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "abajo": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "izq": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "der": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "izquierda": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "derecha": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "base": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "laterales": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "alrededor": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        }
                      }
                    }
                  ]
                },
                "editables": {
                  "type": "object",
                  "description": "Objeto editable del arte (capa «Editable X» → X) → cómo se aplica.",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "enum": [
                          "sublimado",
                          "tpu",
                          "bordado",
                          "dtf",
                          "no_imprimir"
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "proceso"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "proceso": {
                            "enum": [
                              "sublimado",
                              "tpu",
                              "bordado",
                              "dtf"
                            ]
                          },
                          "cruz": {
                            "type": "boolean"
                          }
                        }
                      }
                    ]
                  }
                },
                "tipografias": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/rutaFuente"
                  }
                },
                "ajustes": {
                  "type": "object",
                  "description": "MAPA 712 · mover/rotar/escalar/espejar un objeto editable (el «Editar diseño» de la pantalla). dx/dy: fracción del ancho/alto del diseño (+dx derecha, +dy abajo); rot: grados; scale (o sx/sy por separado; negativo = espejo); talles: opcional (sin talles = todos).",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "dx": {
                        "type": "number"
                      },
                      "dy": {
                        "type": "number"
                      },
                      "rot": {
                        "type": "number"
                      },
                      "scale": {
                        "type": "number"
                      },
                      "sx": {
                        "type": "number"
                      },
                      "sy": {
                        "type": "number"
                      },
                      "talles": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number"
                          ]
                        }
                      }
                    }
                  }
                },
                "colores": {
                  "type": "object",
                  "description": "MAPA 712 · el color CMYK (0 a 1) de un objeto editable: relleno y/o trazo.",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "fill": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "stroke": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  }
                },
                "mapeo_arte": {
                  "type": "object",
                  "description": "MAPA 712 · qué mesa del arte va en cada pieza, a mano: {pieza (genérica o exacta): número de mesa | rótulo escrito en la mesa}. Manda sobre lo automático.",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                },
                "reemplazos": {
                  "type": "object",
                  "description": "MAPA 712 · reemplazar una tipografía del arte por otra del catálogo (GET /tipografias): {fuente_del_arte: fuente_del_catálogo}.",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "tipografia_por_campo": {
                  "type": "object",
                  "description": "MAPA 712 · la tipografía de un campo para ESTE molde (pisa la del diseño): {\"numero\": \"Anton Regular\"}.",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "planilla": {
      "type": "array",
      "minItems": 1,
      "description": "Una fila por prenda. Las claves son los ids de columna de la planilla de la prenda (GET /moldes/{codigo} → planilla.columnas) + «diseno».",
      "items": {
        "type": "object",
        "properties": {
          "diseno": {
            "type": "string"
          },
          "cantidad": {
            "type": [
              "integer",
              "string"
            ]
          },
          "piezas": {
            "type": "object",
            "description": "MAPA 712 · REPO: las piezas que hace esta fila, por variable o molde: {\"v_redondo\": [\"Cuello\", \"Manga 1\"]} (un nombre genérico = todas las suyas). Sin `piezas`: todas.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    }
  },
  "$defs": {
    "rutaArte": {
      "type": "string",
      "pattern": "(?i)\\.(ai|pdf)$",
      "description": "Ruta dentro del .zip."
    },
    "rutaFuente": {
      "type": "string",
      "pattern": "(?i)\\.(ttf|otf)$",
      "description": "Ruta dentro del .zip."
    }
  }
}